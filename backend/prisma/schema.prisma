generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleKey {
  ADMINISTRATOR @map("admin")
  VETERINARIAN  @map("vet")
  RECEPTIONIST  @map("recepcionista")
  ASSISTANT     @map("asistente")
  OWNER         @map("propietario")
}

enum UserStatus {
  ACTIVE   @map("Activo")
  INACTIVE @map("Inactivo")
}

enum PetSpecies {
  DOG     @map("Perro")
  CAT     @map("Gato")
  BIRD    @map("Ave")
  RODENT  @map("Roedor")
  REPTILE @map("Reptil")
  OTHER   @map("Otro")
}

enum PetSex {
  MALE   @map("Macho")
  FEMALE @map("Hembra")
}

enum AppointmentStatus {
  PENDING   @map("Pendiente")
  CONFIRMED @map("Confirmada")
  IN_ROOM   @map("En sala")
  ATTENDED  @map("Atendida")
  CANCELLED @map("Cancelada")
}

enum AppointmentRequestResolution {
  PENDING  @map("Pendiente")
  ACCEPTED @map("Aceptada")
  REJECTED @map("Rechazada")
}

enum ClinicalAttentionType {
  GENERAL_CONSULTATION @map("Consulta general")
  VACCINATION          @map("Vacunación")
  FOLLOW_UP            @map("Control / seguimiento")
  SURGERY              @map("Cirugía")
  EMERGENCY            @map("Urgencia")
  DEWORMING            @map("Desparasitación")
}

enum ConsultationStatus {
  COMPLETED   @map("Completada")
  IN_FOLLOWUP @map("En seguimiento")
}

enum PrescriptionStatus {
  ISSUED    @map("Emitida")
  DISPENSED @map("Dispensada")
}

model Role {
  id        Int      @id @default(autoincrement())
  key       RoleKey  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]

  @@map("roles")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  passwordHash String  @map("password_hash")
  status    UserStatus @default(ACTIVE)
  roleId    Int        @map("role_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  owner     Owner?
  role      Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointmentsAsVeterinarian   Appointment[]  @relation("AppointmentVeterinarian")
  consultationsAsVeterinarian  Consultation[] @relation("ConsultationVeterinarian")
  vaccinesAdministered         Vaccine[]      @relation("VaccineAdministrator")
  prescriptionsAsVeterinarian  Prescription[] @relation("PrescriptionVeterinarian")

  @@index([roleId])
  @@map("users")
}

model Owner {
  id             Int      @id @default(autoincrement())
  name           String
  documentNumber String   @unique @map("document_number")
  phone          String
  email          String   @unique
  address        String
  userId         Int?     @unique @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  pets           Pet[]
  user           User?    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointmentRequests AppointmentRequest[]

  @@map("owners")
}

model Pet {
  id                 Int        @id @default(autoincrement())
  name               String
  species            PetSpecies
  breed              String
  sex                PetSex
  age                String
  color              String
  weight             String
  isNeutered         Boolean    @default(false) @map("is_neutered")
  medicalBackground  String     @map("medical_background")
  photoDataUrl       String?    @map("photo_data_url")
  ownerId            Int        @map("owner_id")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  owner              Owner      @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointments        Appointment[]
  appointmentRequests AppointmentRequest[]
  consultations       Consultation[]
  vaccines            Vaccine[]
  prescriptions       Prescription[]

  @@index([ownerId])
  @@map("pets")
}

model Appointment {
  id              Int                 @id @default(autoincrement())
  scheduledAt     DateTime            @map("scheduled_at")
  petId           Int                 @map("pet_id")
  veterinarianId  Int                 @map("veterinarian_id")
  reason          String
  status          AppointmentStatus   @default(PENDING)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  pet             Pet                 @relation(fields: [petId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  veterinarian    User                @relation("AppointmentVeterinarian", fields: [veterinarianId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedRequest AppointmentRequest?

  @@index([petId])
  @@index([veterinarianId])
  @@map("appointments")
}

model Consultation {
  id               Int                   @id @default(autoincrement())
  petId            Int                   @map("pet_id")
  veterinarianId   Int                   @map("veterinarian_id")
  occurredAt       DateTime              @default(now()) @map("occurred_at")
  type             ClinicalAttentionType
  diagnosis        String
  treatment        String
  recommendations  String
  status           ConsultationStatus    @default(COMPLETED)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  pet              Pet                   @relation(fields: [petId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  veterinarian     User                  @relation("ConsultationVeterinarian", fields: [veterinarianId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vaccines         Vaccine[]
  prescriptions    Prescription[]

  @@index([petId])
  @@index([veterinarianId])
  @@map("consultations")
}

model Vaccine {
  id               Int          @id @default(autoincrement())
  petId            Int          @map("pet_id")
  consultationId   Int?         @map("consultation_id")
  name             String
  administeredAt   DateTime     @default(now()) @map("administered_at")
  nextDueAt        DateTime?    @map("next_due_at")
  administeredById Int?         @map("administered_by_id")
  batch            String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  pet              Pet          @relation(fields: [petId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  consultation     Consultation? @relation(fields: [consultationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  administeredBy   User?        @relation("VaccineAdministrator", fields: [administeredById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([petId])
  @@index([consultationId])
  @@map("vaccines")
}

model Prescription {
  id              Int                @id @default(autoincrement())
  petId           Int                @map("pet_id")
  veterinarianId  Int                @map("veterinarian_id")
  consultationId  Int?               @map("consultation_id")
  issuedAt        DateTime           @default(now()) @map("issued_at")
  instructions    String?
  status          PrescriptionStatus @default(ISSUED)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  pet             Pet                @relation(fields: [petId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  veterinarian    User               @relation("PrescriptionVeterinarian", fields: [veterinarianId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  consultation    Consultation?      @relation(fields: [consultationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items           PrescriptionItem[]

  @@index([petId])
  @@index([veterinarianId])
  @@index([consultationId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int          @map("prescription_id")
  medication     String
  dose           String
  days           Int
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

model AppointmentRequest {
  id                    Int                          @id @default(autoincrement())
  ownerId               Int                          @map("owner_id")
  petId                 Int                          @map("pet_id")
  scheduledAt           DateTime                     @map("scheduled_at")
  reason                String
  resolutionState       AppointmentRequestResolution @default(PENDING) @map("resolution_state")
  rejectionReason       String?                      @map("rejection_reason")
  resolvedAppointmentId Int?                         @unique @map("resolved_appointment_id")
  resolvedAt            DateTime?                    @map("resolved_at")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")
  owner                 Owner                        @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pet                   Pet                          @relation(fields: [petId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedAppointment   Appointment?                 @relation(fields: [resolvedAppointmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ownerId])
  @@index([petId])
  @@map("appointment_requests")
}
